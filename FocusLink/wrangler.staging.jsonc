{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focuslink-sync-staging",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "FOCUSLINK_ACCOUNT_ID": "staging-primary",
    "FOCUSLINK_ALLOWED_ORIGINS": "https://localhost,capacitor://localhost,http://localhost",
    "FOCUSLINK_AUTHORITY_AUDIENCE": "https://personal-mcp-authority-staging.focuslink-poyi-6465e9.workers.dev/authority/identity-focus"
  },
  // FOCUSLINK_AUTHORITY_CAPABILITY is provisioned as a secret and must match
  // the central signer's FOCUSLINK_OBSERVATION_CAPABILITY without entering Git.
  "durable_objects": {
    "bindings": [{ "name": "FOCUSLINK_ACCOUNT", "class_name": "FocusLinkAccount" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FocusLinkAccount"] }
  ],
  "queues": {
    "producers": [
      { "binding": "FOCUSLINK_PUSH_QUEUE", "queue": "focuslink-sync-push-staging" }
    ],
    "consumers": [
      { "queue": "focuslink-sync-push-staging", "max_batch_size": 20, "max_batch_timeout": 5 }
    ]
  },
  "triggers": { "crons": ["17 2 * * *"] },
  "observability": { "enabled": true }
}
